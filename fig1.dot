digraph G {
  rankdir=TB; nodesep=0.25; ranksep=0.22;
  node [shape=box, style="rounded", fontname="Times New Roman", fontsize=11, width=4.6, color="#3d3d3a"];
  edge [color="#3d3d3a", arrowsize=0.7];
  a [label="1. Збирання повідомлень rᵢ про індикатор u\n(фіксація часу, джерела, контрольної суми)"];
  b [label="2. Нормалізація індикатора\n(регістр, punycode, «знешкоджені» записи hxxp, [.])"];
  c [label="3. Граф залежностей між повідомленнями →\nгрупи походження G₁…Gₘ (компоненти зв'язності)"];
  d [label="4. Оцінювання якості wᵢ = q⁰ᵢ · tᵢ\nі вибір репрезентативного свідчення групи"];
  e [label="5. Агрегування: S(u), n⁺, n⁻, K⁺, K⁻"];
  f [label="6. Правило рішення з утриманням і вето", shape=diamond, style="", width=3.6, height=0.9];
  g1 [label="«Підозру обґрунтовано\nдля подальшої перевірки»", width=2.1];
  g2 [label="«Потребує\nдодаткової перевірки»", width=2.1];
  g3 [label="«Наявні свідчення\nне підтверджують підозру»", width=2.1];
  h [label="7. Картка OSINT-перевірки → рішення уповноваженої особи"];
  a->b->c->d->e->f;
  f->g1; f->g2; f->g3;
  {rank=same; g1; g2; g3;}
  g1->h; g2->h; g3->h;
}
